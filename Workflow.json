        "jsCode": "// Tomamos el texto que devuelve el agente de IA\nlet rawOutput = $input.item.json.output || $input.item.json.text || Object.values($input.item.json)[0];\n\n// Limpiamos por si el modelo agregó marcas de código markdown (```json ... ```)\nlet cleanOutput = rawOutput.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n\n// Convertimos el texto JSON en un objeto real de JavaScript que n8n pueda leer por separado\nlet parsedData = JSON.parse(cleanOutput);\n\n// Devolvemos los datos limpios para el siguiente nodo\nreturn { json: parsedData };"
